{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gentle Update Panel",
  "version": "0.3.0",
  "identifier": "dev.gentle.update-panel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gentle Update Panel",
        "width": 1100,
        "height": 740,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Updates for the Gentle AI ecosystem and pi",
    "longDescription": "Checks gentle-ai, engram, gga, pi and every installed pi package for new versions, shows what changed, applies the updates you choose and verifies the result with gentle-ai doctor.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ]
      }
    }
  }
}
